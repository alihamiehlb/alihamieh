# Admin panel (required for /admin on Vercel)
ADMIN_PASSWORD=your-secret-password-min-8-chars
ADMIN_SESSION_SECRET=random-long-string-for-cookie-signing

# Vercel Blob — required to save admin edits in production (Vercel → Storage → Blob → token)
BLOB_READ_WRITE_TOKEN=

# Local phone testing: npm run dev:lan then open http://YOUR_PC_IP:3000 on the same Wi‑Fi
# Vercel deploy: connect GitHub repo, Framework Preset = Next.js, add env vars above, Deploy
