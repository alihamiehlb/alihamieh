# Local secrets — gitignored. Copy the same keys into Vercel.

# Canonical site URL (production default: https://alihamieh.com)
# MUST include https://
NEXT_PUBLIC_SITE_URL=https://alihamieh.com

# Your admin password (min 8 characters)
ADMIN_PASSWORD=your-secret-password-min-8-chars

# Session signing for /admin
ADMIN_SESSION_SECRET=random-long-string-for-cookie-signing

# MongoDB Atlas — required for database storage (create free cluster at mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=portfolio

# Paste from Vercel → Storage → Blob → Connect project → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# Local phone testing: npm run dev:lan then open http://YOUR_PC_IP:3000 on the same Wi‑Fi
# Vercel deploy: connect GitHub repo, Framework Preset = Next.js, add env vars above, Deploy
